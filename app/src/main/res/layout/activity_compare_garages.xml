<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#171A21">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Compare Garages"
        android:textColor="#F3F4F6"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select two garages to compare their details."
        android:textColor="#9CA3AF"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/garageSelectionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <Button
        android:id="@+id/compareSelectedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="52dp"
        android:background="@drawable/button_background"
        android:backgroundTint="@null"
        android:text="Compare Selected"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:textStyle="bold" />

</LinearLayout>
